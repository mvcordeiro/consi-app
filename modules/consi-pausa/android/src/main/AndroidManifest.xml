<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">

  <!-- Saber qual app está na frente e quanto tempo foi usado (Ajustes → Acesso de uso). -->
  <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
  <!-- Abrir a pausa por cima do app que a pessoa tentou abrir. -->
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
  <!-- O vigia roda como serviço em primeiro plano. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <!-- Lembretes do "Cuidar tempo" e a notificação fixa do vigia. -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- Vibração curta do timer flutuante quando o "Cuidar tempo" termina. -->
  <uses-permission android:name="android.permission.VIBRATE" />
  <!-- Voltar a vigiar depois de reiniciar o celular. -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

  <!-- Lista de apps: só os que aparecem no menu de apps (sem QUERY_ALL_PACKAGES). -->
  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.HOME" />
    </intent>
  </queries>

  <application>
    <service
      android:name=".VigiaService"
      android:exported="false"
      android:foregroundServiceType="specialUse">
      <property
        android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="Mostra uma pausa antes de abrir os apps que a pessoa escolheu no Consi." />
    </service>
    <!-- Alarme do convite do piloto (dia 7): só o próprio app dispara. -->
    <receiver
      android:name=".ConvitePilotoReceiver"
      android:exported="false" />
    <!-- Lembrete diário de escrita no Diário: só o próprio app dispara. -->
    <receiver
      android:name=".LembreteDiarioReceiver"
      android:exported="false" />
    <!-- Lembretes de atividades: só o próprio app dispara. -->
    <receiver
      android:name=".LembreteAtividadesReceiver"
      android:exported="false" />
    <receiver
      android:name=".InicioReceiver"
      android:exported="false">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
