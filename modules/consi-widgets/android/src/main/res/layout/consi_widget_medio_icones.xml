<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/consi_widget_fundo"
  android:clipToOutline="true"
  android:padding="12dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center">
      <FrameLayout android:id="@+id/acao_registrar" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/consi_widget_botao_primario" android:contentDescription="Registrar emoção" >
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@drawable/consi_widget_icone_sorriso" android:importantForAccessibility="no" />
      </FrameLayout>
      <FrameLayout android:id="@+id/acao_escrever" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/consi_widget_botao_secundario" android:contentDescription="Escrever no Diário" android:layout_marginStart="8dp">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@drawable/consi_widget_icone_diario" android:importantForAccessibility="no" />
      </FrameLayout>
      <FrameLayout android:id="@+id/acao_atividades" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/consi_widget_botao_secundario" android:contentDescription="Explorar atividades" android:layout_marginStart="8dp">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@drawable/consi_widget_icone_atividade" android:importantForAccessibility="no" />
      </FrameLayout>
  </LinearLayout>
