    "#2F4ACB": "{props.corDecor || '#2F4ACB'}",
    "#F2A0A3": "{props.corAlerta || '#F2A0A3'}",
    "#4D4D4B": "{props.corSuave || '#4D4D4B'}",
    "#4362E5": "{props.corBalao || '#4362E5'}"
  }
}
