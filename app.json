{
  "expo": {
    "name": "Consi",
    "slug": "consi-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/bbac7122-6119-4de3-a386-5ebb1048cfe3",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.consi.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#111D4F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#FFF7E8",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#111D4F"
          }
        }
      ],
      "expo-sharing",
      [
        "expo-audio",
        {
          "microphonePermission": "O Consi usa o microfone para gravar áudios no seu diário."
        }
      ],
      "expo-asset",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-secure-store"
    ],
    "scheme": "consi",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "versaoNativa": {
        "url": "https://PREENCHER-ENDERECO-DO-ARQUIVO/consi-versao.json"
      },
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "bbac7122-6119-4de3-a386-5ebb1048cfe3"
      }
    }
  }
}
